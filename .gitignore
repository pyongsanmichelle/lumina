.gradle
**/build/
!**/src/**/build/

# Local environment secrets (use .env.example as template)
.env
.env.local
.env.*.local

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# BFF Gradle generated files
bff/.gradle/

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# BFF build directory (explicit)
bff/build/
