title AWS Architecture (Nuxt SSG/SPA + OIDC + ECS + RDS)

rectangle "Users (Browser)" as user
rectangle "OIDC IdP\n(Entra ID / Keycloak / Okta)" as idp

rectangle "CloudFront\napp.example.com" as cf
storage "S3\n(Nuxt static)" as s3

rectangle "VPC" as vpc {
  rectangle "Public Subnets" as pub {
    [ALB\n/api/*] as alb
  }
  rectangle "Private Subnets" as priv {
    rectangle "ECS Cluster (Fargate)" as ecs {
      [BFF\nSpring Boot Kotlin\nREST] as bff
      [Backend\nSpring Boot Kotlin\nREST] as be
      [Batch Task\nSpring Batch\nScheduled] as batch
    }
    database "RDS PostgreSQL" as rds
  }
}

[EventBridge Scheduler] as ev
[CloudWatch] as cw
[Secrets Manager] as secrets
[SSM Parameter Store] as ssm
[ECR] as ecr

user --> cf : HTTPS\n/ (static) + /api/*
cf --> s3 : Origin (static)
cf --> alb : Origin (/api/*)

user --> idp : OIDC login\nAuth Code + PKCE
user --> alb : HTTPS\nAuthorization: Bearer

alb --> bff : route /api/*
