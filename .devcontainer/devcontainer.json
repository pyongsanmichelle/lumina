{
  "name": "web-system-dev",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspaces/repo",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "features": {},
  "postCreateCommand": "corepack enable && (cd apps/frontend && pnpm install) && ./gradlew -v",
  "runArgs": ["--init"],
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspaces/repo,type=bind,consistency=cached"
  ]
}
